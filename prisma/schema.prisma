// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    // status/priority/kind are String (not native enum) and validated via Zod
    // in app code (src/lib/tickets.ts) so the schema stays portable.
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (email + password). Account / Session / VerificationToken are unused
// today but kept so an OAuth adapter can be dropped in later.
// ---------------------------------------------------------------------------

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    // bcrypt hash for email + password sign-in
    password      String?

    accounts        Account[]
    sessions        Session[]
    ticketsAuthored Ticket[]      @relation("TicketAuthor")
    ticketsAssigned Ticket[]      @relation("TicketAssignee")
    ticketEntries   TicketEntry[]
    attachments     Attachment[]
}

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String? @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.Text
    session_state            String?
    refresh_token_expires_in Int?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tickets — self-contained: client / vehicle details are plain free-text
// fields, no separate tables.
// ---------------------------------------------------------------------------

model Ticket {
    // Small sequential int — shown to users as "#42", used in the URL.
    id   Int      @id @default(autoincrement())
    date DateTime @default(now()) // "Data" — prefilled to today in the form

    // "OPEN" | "IN_PROGRESS" | "WAITING_PARTS" | "WAITING_CLIENT" | "RESOLVED" | "CLOSED"
    status String @default("OPEN")
    // "LOW" | "NORMAL" | "HIGH" | "URGENT"
    priority String @default("NORMAL")

    client String? // client name + surname, free text ("just a note")
    plate  String? // targa
    make   String? @default("TOYOTA") // brand
    model  String?
    km     Int?
    ol     String? // OL / order number — reference / ID from an external system

    systemModel     String? // "Modello radio" — infotainment / multimedia system model
    softwareVersion String? // firmware / MMI / software version, when known

    complaint      String? @db.Text // Lamentela cliente
    diagnosis      String? @db.Text // Diagnosi
    resolutionNote String? @db.Text // Resolution note

    openedAt   DateTime  @default(now())
    closedAt   DateTime?
    archivedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    authorId   String // "Autore log" — defaults to the current user
    author     User    @relation("TicketAuthor", fields: [authorId], references: [id])
    assigneeId String?
    assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])

    entries     TicketEntry[]
    attachments Attachment[]

    @@index([status])
    @@index([plate])
}

// Append-only running log for a ticket ("interfaccia log").
model TicketEntry {
    id        String   @id @default(cuid())
    body      String   @db.Text
    system    Boolean  @default(false) // true = auto entry ("status → RESOLVED")
    createdAt DateTime @default(now())

    ticketId Int
    ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    authorId String
    author   User   @relation(fields: [authorId], references: [id])

    @@index([ticketId, createdAt])
}

model Attachment {
    id         String   @id @default(cuid())
    kind       String // "AUDIO" | "IMAGE" | "OTHER"
    filename   String
    mimeType   String
    size       Int
    storageKey String   @db.Text // key/path in object storage
    createdAt  DateTime @default(now())

    ticketId     Int
    ticket       Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    uploadedById String
    uploadedBy   User   @relation(fields: [uploadedById], references: [id])

    @@index([ticketId])
}
